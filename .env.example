# CryptoNoises docker-compose configuration. Copy to .env and fill in.
#
#   cp .env.example .env
#
# Everything here is read by docker/config/consts-secrets.php and docker/config/environment.php,
# which the container entrypoint installs as config/*.php. To use hand-written config files instead,
# mount them over /opt/cryptonoises/config/consts-secrets.php and .../environment.php.

#=======================================================================================================================
# Database
#=======================================================================================================================

DB_ROOT_PASSWORD=change-me-root
DB_USER=cryptonoises
DB_PASSWORD=change-me

# Defaults match the README. MAIN and LOG are deliberately the same database.
DB_HOST=db
DB_PORT=3306
DB_NAME_MAIN=cryptonoises
DB_NAME_SHARED=cryptonoises_shared
DB_NAME_TEZOS=cryptonoises_tezos
DB_NAME_TEZOS_LOG=cryptonoises_tezos_log

# Tune to the host: the indexer is write-heavy
MYSQL_BUFFER_POOL_SIZE=2G
MYSQL_MAX_CONNECTIONS=200

#=======================================================================================================================
# Indexer start point
#=======================================================================================================================

# Block the indexer starts from, applied by db-init on a fresh database.
#
#   1          the whole chain history. Faithful, but catching up to the head takes days (see the README).
#   <level>    start here instead; catches up in minutes. The indexer then only knows tokens minted from this
#              block on, and ownership of older tokens stays incomplete until their balances change.
#              sql/data/README.md lists the consequences in full.
#
# Look up the current head at https://api.tzkt.io/v1/head and subtract a margin to index recent history only.
TEZOS_START_LEVEL=1

#=======================================================================================================================
# Image
#=======================================================================================================================

# Which image the services run. Unset means "build it here", which is what you want for development.
#
# For a deployment, point this at a tag published by .github/workflows/docker-image.yml and pull instead of
# building. Prefer the immutable sha- tag over "main", so you know exactly what is running and a redeploy is a
# deliberate change of this one value:
#
#   CN_IMAGE=ghcr.io/teia-community/cryptonoises:sha-abc1234
#   docker compose pull && docker compose up -d
#
# CN_IMAGE=

#=======================================================================================================================
# Deployment
#=======================================================================================================================

# production | development | development-local
# Token mint / update notifications only work in "production": see "Enabling the bots" in the README.
APP_ENVIRONMENT=development-local

# Public base URLs. Telegram only delivers webhooks over HTTPS, so put a TLS proxy in front of these.
APP_PUBLIC_API_URL=http://localhost:8080
APP_PUBLIC_DOMAIN=http://localhost:8081

# How long a worker process lives before it exits and the restart policy recycles it, in seconds.
#
# This is a process lifetime, not a limit for one task: a worker finishes the task in hand first. Restarting
# periodically is cheap insurance against a slow leak in a long-lived PHP process. 55 is the old cron-tick value;
# with the worker services there is no reason to go that low.
#   3600 = restart hourly (default)   0 or empty = fall back to 55
WORKER_TIME_LIMIT_SEC=3600

# Host ports published by the nginx service
PORT_API=8080
PORT_APP=8081
PORT_MEDIA=8082

# Where the media previews are served from; must point at the media listener (PORT_MEDIA)
TEZOS_IPFS_LOCAL_BASE_URL=http://localhost:8082

# TzKT API base URL, no trailing slash. All chain data comes from here.
#
# The public api.tzkt.io rate-limits. The indexer queries it for every block, every bigmap it has not seen and
# every contract, so the moment you scale the workers up you start getting HTTP 429, which shows up as
# "Cannot get bigmap data from tzkt" in the fixer notices. Run your own TzKT if you index at any scale.
TEZOS_TZKT_API_URL=https://api.tzkt.io/v1

# IPFS gateway that token metadata and media are READ through (not the one serving previews).
# The public ipfs.io gateway rate-limits heavily: the metadata and media jobs then keep failing with
# "IPFS returned empty data". Point this at a gateway you run or pay for, with a trailing /ipfs/.
TEZOS_IPFS_GATEWAY_URL=https://ipfs.io/ipfs/

#=======================================================================================================================
# Telegram (tokens from @BotFather) - leave empty to disable
#=======================================================================================================================

TELEGRAM_BOT_API=

TELEGRAM_ASSISTANT_API=
TELEGRAM_ASSISTANT_USER_ID=0

TELEGRAM_DEBUGGER_API=
TELEGRAM_DEBUGGER_USER_ID=0

# Random secret Telegram sends back in X-Telegram-Bot-Api-Secret-Token: openssl rand -hex 32
# After changing it: docker compose run --rm php commands/run /telegram/webhook/set
TELEGRAM_WEBHOOK_SECRET=

#=======================================================================================================================
# Discord (https://discord.com/developers/applications) - leave empty to disable
#=======================================================================================================================

DISCORD_TOKEN_MAINBOT=
DISCORD_TOKEN_ASSISTANT=
DISCORD_GUILD_ID=
DISCORD_CLIENT_ID_MAINBOT=

# Optional channel ids (see config/environment.example.php for what each one does)
DISCORD_CHANNEL_AUTO_JOIN_ANY=
DISCORD_CHANNEL_AUTO_JOIN_HI=
DISCORD_CHANNEL_MISSED_NOTIFICATIONS=

#=======================================================================================================================
# Public links shown in bot messages (empty hides the related button or line)
#=======================================================================================================================

LINK_HOMEPAGE=
LINK_TWITTER=
LINK_DISCORD_INVITE=
LINK_DISCORD_TICKET_URL=
LINK_DISCORD_PRIVACY_HELP_URL=
LINK_PRIVACY_POLICY=

#=======================================================================================================================
# Limits (the same for every user)
#=======================================================================================================================

LIMIT_WALLETS=50
LIMIT_FOLLOWING=1000
LIMIT_OFFERS_MAX_HOLDERS=250

#=======================================================================================================================
# Media previews
#=======================================================================================================================

MEDIA_THUMBNAIL_WIDTH=256
MEDIA_THUMBNAIL_QUALITY=60
MEDIA_VIDEO_PREVIEW=false
MEDIA_ANIMATED_PREVIEW=false
MEDIA_MAX_DURATION_SEC=30
MEDIA_TOOL_TIMEOUT_SEC=60

#=======================================================================================================================
# Advanced overrides - the container defaults are right for the compose stack, change only if you know why
#=======================================================================================================================

# How many times wait-for-db retries, 2 seconds apart, before giving up (used by db-init and the services)
# DB_WAIT_TRIES=60

# Paths inside the container. These are the compose volume mount points: ipfs-previews and private-storage.
# TEZOS_IPFS_LOCAL_BASE_PATH=/opt/cryptonoises/external-ipfs
# TEZOS_PRIVATE_STORAGE_BASE_PATH=/opt/cryptonoises/external-storage

# External tools. ImageMagick 7 (Debian trixie, which the image is based on) installs as "magick";
# version 6 installs as "convert".
# TEZOS_CMD_IMAGEMAGICK_CONVERT=/usr/bin/magick
# TEZOS_CMD_FFMPEG=/usr/bin/ffmpeg
# TEZOS_CMD_TIMEOUT=/usr/bin/timeout

# Optional extra previews, both off by default (MEDIA_VIDEO_PREVIEW / MEDIA_ANIMATED_PREVIEW above)
# MEDIA_VIDEO_WIDTH=512
# MEDIA_VIDEO_BITRATE=1M
# MEDIA_ANIMATED_WIDTH=240
# MEDIA_ANIMATED_FPS=30

#=======================================================================================================================
# Broadcast feed users (internal users.id values; see config/environment.example.php) - optional
#=======================================================================================================================

CHANNEL_USER_TEZOS_GLOBAL=
CHANNEL_USER_TEIA=
CHANNEL_USER_OBJKT_COM=
CHANNEL_USER_FXHASH=
CHANNEL_USER_VERSUM=
CHANNEL_USER_KALAMINT=
CHANNEL_USER_RARIBLE_TEZ=
CHANNEL_USER_METADATA_UPDATES=
