{
    "name": "andrii-bakulin/cryptonoises",
    "description": "Telegram and Discord bots for Tezos wallet / NFT activity, with a Tezos indexer",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrii Bakulin",
            "email": "andrii.bakulin@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",

        "bcosca/fatfree": "^3.9",

        "davtur19/turibot": "^2.16",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",

        "team-reflex/discord-php": "^10.72",
        "ratchet/pawl": "^0.4.3",
        "react/event-loop": "^1.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "files": [
            "config/VssCfg.php"
        ],
        "psr-4": {
            "CryptoCore\\": "src/CryptoCore",
            "CryptoNoises\\": "src/CryptoNoises",
            "CryptoNoisesTezos\\": "src/CryptoNoisesTezos"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        }
    }
}
